meta {
  name: Decode Access Token
  type: http
  seq: 2
}

get {
  url: {{auth_url}}/.well-known/openid-configuration
  body: none
  auth: inherit
}

script:post-response {
  // The checkpoint: the collection's OAuth2 config just ran the code + PKCE dance, and this
  // request carried the resulting Bearer token. Decode it and show the claims.
  const authorization = req.getHeader('Authorization') || '';
  const jwt = authorization.replace(/^Bearer /, '');
  const decode = (part) => JSON.parse(Buffer.from(part, 'base64url').toString());
  const [header, payload] = jwt.split('.');
  console.log('access token header:', JSON.stringify(decode(header), null, 2));
  console.log('access token claims:', JSON.stringify(decode(payload), null, 2));
}

docs {
  Runs the same discovery request but with the collection's OAuth2 auth attached, then decodes the
  access token in the post-response script — check the console for the claims: `sub`, `role`,
  `aud: api`, the granted scopes, and `exp − iat` = the 15-minute access-token lifetime.
}
