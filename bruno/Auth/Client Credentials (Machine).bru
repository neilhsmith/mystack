meta {
  name: Client Credentials (Machine)
  type: http
  seq: 6
}

post {
  url: {{auth_url}}/connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: client_credentials
  client_id: {{machine_client_id}}
  client_secret: {{machine_client_secret}}
  scope: api.read
}

script:post-response {
  if (res.status !== 200) return;
  const token = res.body.access_token;
  bru.setEnvVar('machine_access_token', token);
  const b64 = token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');
  const claims = JSON.parse(Buffer.from(b64.padEnd(Math.ceil(b64.length / 4) * 4, '='), 'base64').toString());
  console.log('machine token claims:', JSON.stringify(claims, null, 2));
}

docs {
  The machine flow: the seeded confidential `dev-machine` client trades its secret for its own
  access token — no browser, no user, no sign-in page. Check the console: `sub` is the client id,
  the scopes are what it asked for, and there is no email, role or permission claim anywhere —
  and no id token or refresh token in the response either.

  Try `scope: api.read api.write` to watch the refusal: the client is seeded with api.read alone.

  Stashes {{machine_access_token}} for the introspection request.
}
