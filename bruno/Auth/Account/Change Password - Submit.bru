meta {
  name: Change Password - Submit
  type: http
  seq: 13
}

post {
  url: {{auth_url}}/change-password
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  CurrentPassword: {{account_new_password}}
  NewPassword: {{account_password}}
  ConfirmPassword: {{account_password}}
  __RequestVerificationToken: {{csrf}}
}

docs {
  As shipped this rotates the password back from account_new_password to account_password, so a
  full run of the folder ends where it started. Other sessions' refresh tokens are revoked, this
  cookie session survives, and the "Your MyStack password was changed" notification lands in
  Mailpit.
}
