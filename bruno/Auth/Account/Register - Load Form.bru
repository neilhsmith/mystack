meta {
  name: Register - Load Form
  type: http
  seq: 1
}

get {
  url: {{auth_url}}/register
  body: none
  auth: none
}

script:post-response {
  // Every account page POSTs with ASP.NET's antiforgery pair: the cookie this response set
  // (Bruno's jar keeps it) plus the hidden form field captured here.
  const match = res.body.match(/name="__RequestVerificationToken"[^>]*value="([^"]+)"/);
  bru.setVar('csrf', match ? match[1] : '');
}

docs {
  Loads the register form to collect the antiforgery token, then run "Register - Submit".
  Needs auth (`dotnet run --project server/auth/src`) and, for the email to arrive, the worker
  (`dotnet run --project server/worker/src`) plus compose's RabbitMQ and Mailpit.
}
