meta {
  name: Forgot Password - Submit
  type: http
  seq: 7
}

post {
  url: {{auth_url}}/forgot-password
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  Email: {{account_email}}
  __RequestVerificationToken: {{csrf}}
}

docs {
  Requests a reset link for {{account_email}} — the generic 200 is identical for unknown and
  unconfirmed addresses, and only a confirmed account actually gets mail. Run
  "Mailpit - Read Latest" next to capture the reset link (it expires after two hours).
}
