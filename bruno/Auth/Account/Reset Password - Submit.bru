meta {
  name: Reset Password - Submit
  type: http
  seq: 9
}

post {
  url: {{auth_url}}/reset-password?userId={{reset_user_id}}&token={{reset_token}}
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  UserId: {{reset_user_id}}
  Token: {{reset_token}}
  Password: {{account_new_password}}
  ConfirmPassword: {{account_new_password}}
  __RequestVerificationToken: {{csrf}}
}

docs {
  Sets the password to {{account_new_password}} and revokes every outstanding grant — a cached
  Bruno OAuth token stops refreshing here, which is the point. From now on sign in with the new
  password (update account_password in the environment if you want the other requests to keep
  working). Submitting again shows the single-use property: "Reset failed". A
  "Your MyStack password was changed" notification lands in Mailpit too.
}
