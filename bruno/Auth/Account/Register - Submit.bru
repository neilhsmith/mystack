meta {
  name: Register - Submit
  type: http
  seq: 2
}

post {
  url: {{auth_url}}/register
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  Email: {{account_email}}
  Password: {{account_password}}
  ConfirmPassword: {{account_password}}
  __RequestVerificationToken: {{csrf}}
}

docs {
  Registers {{account_email}}. The answer is the same generic "check your email" whether or not
  the address already has an account (anti-enumeration) — the truth is in Mailpit: run
  "Mailpit - Read Latest" next to pull the confirmation link out of the inbox.
}
