meta {
  name: Change Password - Load Form
  type: http
  seq: 12
}

get {
  url: {{auth_url}}/change-password
  body: none
  auth: none
}

script:post-response {
  const match = res.body.match(/name="__RequestVerificationToken"[^>]*value="([^"]+)"/);
  bru.setVar('csrf', match ? match[1] : '');
}

docs {
  Requires the cookie from "Sign In - Submit" — anonymous requests get a 302 to /signin instead
  of the form.
}
