meta {
  name: Reset Password - Load Page
  type: http
  seq: 8
}

get {
  url: {{auth_url}}/reset-password?userId={{reset_user_id}}&token={{reset_token}}
  body: none
  auth: none
}

script:post-response {
  const match = res.body.match(/name="__RequestVerificationToken"[^>]*value="([^"]+)"/);
  bru.setVar('csrf', match ? match[1] : '');
}

docs {
  The emailed reset link: a GET that renders the new-password form with the token hidden in it
  and changes nothing. "Reset Password - Submit" is what consumes the token.
}
