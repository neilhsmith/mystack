meta {
  name: Sign In (Scripted)
  type: http
  seq: 5
}

post {
  url: {{auth_url}}/connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: authorization_code
  client_id: {{client_id}}
  redirect_uri: {{callback_url}}
  code: {{scripted_code}}
  code_verifier: {{scripted_verifier}}
}

script:pre-request {
  // The full authorization code + PKCE dance with no browser window — the same three steps the
  // test suite drives: load the sign-in form (cookies + antiforgery token), post the
  // credentials, hit /connect/authorize and catch the code off the redirect. The server stays
  // exactly as strict as for any real client; only the driver is scripted. Still no password
  // grant anywhere.
  const axios = require('axios');
  const CryptoJS = require('crypto-js');

  const jar = {};
  const keep = (response) => (response.headers['set-cookie'] || []).forEach((cookie) => {
    const [pair] = cookie.split(';');
    const split = pair.indexOf('=');
    jar[pair.slice(0, split).trim()] = pair.slice(split + 1);
  });
  const cookies = () => Object.entries(jar).map(([name, value]) => `${name}=${value}`).join('; ');
  const http = axios.create({
    baseURL: bru.getEnvVar('auth_url'),
    maxRedirects: 0,
    validateStatus: () => true,
  });

  const form = await http.get('/signin');
  keep(form);
  const antiforgery = form.data.match(/name="__RequestVerificationToken"[^>]*value="([^"]+)"/);
  if (!antiforgery) throw new Error('no antiforgery token on /signin — is auth up on ' + bru.getEnvVar('auth_url') + '?');

  const signIn = await http.post(
    '/signin',
    new URLSearchParams({
      Email: bru.getEnvVar('signin_email'),
      Password: bru.getEnvVar('signin_password'),
      __RequestVerificationToken: antiforgery[1],
    }).toString(),
    { headers: { 'content-type': 'application/x-www-form-urlencoded', cookie: cookies() } }
  );
  keep(signIn);
  if (signIn.status !== 302) {
    throw new Error('sign-in was refused (' + signIn.status + ') — check signin_email / signin_password');
  }

  const verifier = Array.from({ length: 64 }, () => '0123456789abcdef'[Math.floor(Math.random() * 16)]).join('');
  const challenge = CryptoJS.SHA256(verifier)
    .toString(CryptoJS.enc.Base64)
    .replace(/\+/g, '-')
    .replace(/\//g, '_')
    .replace(/=+$/, '');

  const authorize = await http.get('/connect/authorize', {
    params: {
      client_id: bru.getEnvVar('client_id'),
      redirect_uri: bru.getEnvVar('callback_url'),
      response_type: 'code',
      scope: bru.getEnvVar('signin_scope'),
      code_challenge: challenge,
      code_challenge_method: 'S256',
      state: 'scripted',
    },
    headers: { cookie: cookies() },
  });
  const location = authorize.headers['location'] || '';
  const code = (location.match(/[?&]code=([^&]+)/) || [])[1];
  if (!code) {
    throw new Error('authorize did not return a code: ' + authorize.status + ' ' + location);
  }

  bru.setVar('scripted_code', decodeURIComponent(code));
  bru.setVar('scripted_verifier', verifier);
}

script:post-response {
  if (res.status !== 200) return;
  bru.setEnvVar('access_token', res.body.access_token);
  if (res.body.refresh_token) bru.setEnvVar('refresh_token', res.body.refresh_token);

  const decode = (part) => {
    const b64 = part.replace(/-/g, '+').replace(/_/g, '/');
    return JSON.parse(Buffer.from(b64.padEnd(Math.ceil(b64.length / 4) * 4, '='), 'base64').toString());
  };
  const claims = decode(res.body.access_token.split('.')[1]);
  console.log('signed in as:', claims.sub, claims.email || '', JSON.stringify(claims.role || ''));
  console.log('access token claims:', JSON.stringify(claims, null, 2));
}

docs {
  The fast front door: sign in as {{signin_email}} / {{signin_password}} and come back holding a
  completely ordinary user token — no browser window, no cached sessions, no Bruno OAuth2 store.
  Every run is a fresh sign-in, so switching users is just editing the two env vars.

  The pre-request script drives the real protocol (sign-in form → authorize → PKCE exchange);
  this request IS the token exchange, so the response you see is the real token response.
  Exports {{access_token}} and {{refresh_token}}; "Refresh Token (Scripted)" rolls them forward.

  Narrow the token for authz testing by editing {{signin_scope}} — e.g. drop api.write and watch
  the API refuse writes once it exists.

  If Bruno complains about require() when this first runs, allow the collection's scripts
  (Collection Settings → Security → developer mode).
}
