meta {
  name: End Session - Load Confirmation
  type: http
  seq: 13
}

get {
  url: {{auth_url}}/connect/endsession
  body: none
  auth: none
}

script:post-response {
  const match = res.body.match(/name="__RequestVerificationToken"[^>]*value="([^"]+)"/);
  bru.setVar('csrf', match ? match[1] : '');
}

docs {
  A hint-less request — no id_token_hint — so instead of acting, auth renders the end-session
  confirmation page (auth-track 14): ending a session takes proof or confirmation. Run a sign-in
  first so there is a session to end; the page renders either way.
}
