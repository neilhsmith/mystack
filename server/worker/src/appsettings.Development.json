{
  // compose.yaml's defaults, so `docker compose up -d` and `dotnet run` line up with no further
  // setup. Local infrastructure credentials, not a secret — every other environment supplies
  // both connection strings from its own configuration, and startup fails without them.
  "ConnectionStrings": {
    "WorkerDb": "Host=localhost;Port=5432;Database=mystack;Username=mystack;Password=mystack",
    "MessageBroker": "amqp://localhost"
  }
}
