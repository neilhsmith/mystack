{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Names this running stack instance; cookie names carry it so side-by-side instances on one
  // host keep disjoint browser jars. Override it (Instance__Name) when running a second stack.
  "Instance": {
    "Name": "mystack"
  },
  "Database": {
    "Migrate": false,
    "Seed": true
  },
  "Oidc": {
    "AccessTokenLifetime": "00:15:00",
    "IdentityTokenLifetime": "00:15:00",
    "AuthorizationCodeLifetime": "00:05:00",
    "RefreshTokenLifetime": "14.00:00:00"
  }
}
