@page "/resend-confirmation"
@model MyStack.Auth.Pages.ResendConfirmationModel
@{
    ViewData["Title"] = Model.Sent ? "Check your email" : "Resend confirmation";
}
@if (Model.Sent)
{
    <div class="grid gap-1 px-4 text-center">
        <h1 class="text-lg leading-snug font-semibold tracking-tight">Check your email</h1>
        <p class="text-muted-foreground text-sm">If that address needs it, we've sent a confirmation email.</p>
    </div>
    <p class="text-muted-foreground px-4 text-center text-sm"><a href="/signin" class="text-foreground font-medium underline underline-offset-4">Back to sign in</a></p>
}
else
{
    <div class="grid gap-1 px-4 text-center">
        <h1 class="text-lg leading-snug font-semibold tracking-tight">Resend confirmation</h1>
        <p class="text-muted-foreground text-sm">Enter your email address and we'll send the confirmation email again.</p>
    </div>
    <form method="post" class="grid gap-4 px-4">
        <partial name="_ErrorSummary" />
        <div class="grid gap-2">
            <label asp-for="Email" class="text-sm leading-none font-medium select-none">Email</label>
            <input asp-for="Email" type="email" autocomplete="username" required
                   aria-invalid="@ViewData.ModelState.AriaInvalid("Email")" aria-describedby="Email-error"
                   class="border-input h-8 w-full min-w-0 rounded-lg border bg-transparent px-2.5 py-1 text-base md:text-sm transition-colors outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:bg-input/30 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40" />
            <p asp-validation-for="Email" id="Email-error" class="text-destructive text-sm empty:hidden"></p>
        </div>
        <button type="submit"
                class="bg-primary text-primary-foreground hover:bg-primary/80 inline-flex h-8 w-full items-center justify-center gap-1.5 rounded-lg border border-transparent bg-clip-padding px-2.5 text-sm font-medium whitespace-nowrap transition-all outline-none select-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 active:translate-y-px">Resend confirmation</button>
    </form>
}
