@page "/reset-password"
@model MyStack.Auth.Pages.ResetPasswordModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Reset your password</title>
</head>
<body>
    <main>
        @if (Model.Done)
        {
            <h1>Password reset</h1>
            <p>Your password has been changed and other sessions have been signed out.
                <a href="/signin">Sign in</a></p>
        }
        else if (Model.Failed)
        {
            <h1>Reset failed</h1>
            <p>The reset link is invalid or has expired.</p>
            <p><a href="/forgot-password">Request a new reset link</a></p>
        }
        else
        {
            <h1>Choose a new password</h1>
            <form method="post">
                <div asp-validation-summary="All" role="alert"></div>
                <input asp-for="UserId" type="hidden" />
                <input asp-for="Token" type="hidden" />
                <div>
                    <label asp-for="Password">New password</label>
                    <input asp-for="Password" type="password" autocomplete="new-password" required />
                </div>
                <div>
                    <label asp-for="ConfirmPassword">Confirm new password</label>
                    <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required />
                </div>
                <button type="submit">Reset password</button>
            </form>
        }
    </main>
</body>
</html>
