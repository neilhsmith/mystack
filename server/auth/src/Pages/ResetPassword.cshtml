@page "/reset-password"
@model MyStack.Auth.Pages.ResetPasswordModel
@{
    ViewData["Title"] = Model.Done ? "Password reset"
        : Model.Failed ? "Reset failed"
        : "Choose a new password";
}
@if (Model.Done)
{
    <div class="grid gap-1 px-4 text-center">
        <h1 class="text-lg leading-snug font-semibold tracking-tight">Password reset</h1>
        <p class="text-muted-foreground text-sm">Your password has been changed and other sessions have been signed out.</p>
    </div>
    <p class="text-muted-foreground px-4 text-center text-sm"><a href="/signin" class="text-foreground font-medium underline underline-offset-4">Sign in</a></p>
}
else if (Model.Failed)
{
    <div class="grid gap-1 px-4 text-center">
        <h1 class="text-lg leading-snug font-semibold tracking-tight">Reset failed</h1>
        <p class="text-muted-foreground text-sm">The reset link is invalid or has expired.</p>
    </div>
    <p class="text-muted-foreground px-4 text-center text-sm"><a href="/forgot-password" class="text-foreground font-medium underline underline-offset-4">Request a new reset link</a></p>
}
else
{
    <div class="grid gap-1 px-4 text-center">
        <h1 class="text-lg leading-snug font-semibold tracking-tight">Choose a new password</h1>
        <p class="text-muted-foreground text-sm">Other sessions are signed out when it changes.</p>
    </div>
    <form method="post" class="grid gap-4 px-4">
        <partial name="_ErrorSummary" />
        <input asp-for="UserId" type="hidden" />
        <input asp-for="Token" type="hidden" />
        <div class="grid gap-2">
            <label asp-for="Password" class="text-sm leading-none font-medium select-none">New password</label>
            <input asp-for="Password" type="password" autocomplete="new-password" required
                   aria-invalid="@ViewData.ModelState.AriaInvalid("Password")" aria-describedby="Password-error"
                   class="border-input h-8 w-full min-w-0 rounded-lg border bg-transparent px-2.5 py-1 text-base md:text-sm transition-colors outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:bg-input/30 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40" />
            <p asp-validation-for="Password" id="Password-error" class="text-destructive text-sm empty:hidden"></p>
        </div>
        <div class="grid gap-2">
            <label asp-for="ConfirmPassword" class="text-sm leading-none font-medium select-none">Confirm new password</label>
            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required
                   aria-invalid="@ViewData.ModelState.AriaInvalid("ConfirmPassword")" aria-describedby="ConfirmPassword-error"
                   class="border-input h-8 w-full min-w-0 rounded-lg border bg-transparent px-2.5 py-1 text-base md:text-sm transition-colors outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:bg-input/30 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40" />
            <p asp-validation-for="ConfirmPassword" id="ConfirmPassword-error" class="text-destructive text-sm empty:hidden"></p>
        </div>
        <button type="submit"
                class="bg-primary text-primary-foreground hover:bg-primary/80 inline-flex h-8 w-full items-center justify-center gap-1.5 rounded-lg border border-transparent bg-clip-padding px-2.5 text-sm font-medium whitespace-nowrap transition-all outline-none select-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 active:translate-y-px">Reset password</button>
    </form>
}
