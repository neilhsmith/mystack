@page "/error/{status:int?}"
@model MyStack.Auth.Pages.ErrorModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Model.Title</title>
</head>
<body>
    <main>
        <h1>@Model.Title</h1>
        <p>@Model.Message</p>
        @if (Model.Detail is not null)
        {
            <p>@Model.Detail</p>
        }
        <p><a href="/">Back to safety</a></p>
    </main>
</body>
</html>
