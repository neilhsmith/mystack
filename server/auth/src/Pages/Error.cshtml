@page "/error/{status:int?}"
@model MyStack.Auth.Pages.ErrorModel
@{
    ViewData["Title"] = Model.Title;
}
<div class="grid gap-1 px-4 text-center">
    <h1 class="text-lg leading-snug font-semibold tracking-tight">@Model.Title</h1>
    <p class="text-muted-foreground text-sm">@Model.Message</p>
    @if (Model.Detail is not null)
    {
        <p class="text-muted-foreground text-sm">@Model.Detail</p>
    }
</div>
