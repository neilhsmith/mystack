@page "/"
@model MyStack.Auth.Pages.IndexModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>MyStack account</title>
</head>
<body>
    <main>
        <h1>MyStack account</h1>
        @if (Model.Email is not null)
        {
            <p>Signed in as <strong>@Model.Email</strong>.</p>
            <p><a href="/change-password">Change password</a></p>
            <p><a href="/connect/endsession">Sign out</a></p>
        }
        else
        {
            <p><a href="/signin">Sign in</a></p>
            <p><a href="/register">Create an account</a></p>
        }
    </main>
</body>
</html>
