@page "/confirm-email"
@model MyStack.Auth.Pages.ConfirmEmailModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Confirm your email</title>
</head>
<body>
    <main>
        @if (Model.Confirmed)
        {
            <h1>Email confirmed</h1>
            <p>Your account is active. <a href="/signin">Sign in</a></p>
        }
        else if (Model.AlreadyConfirmed)
        {
            <h1>Already confirmed</h1>
            <p>This email address was already confirmed. <a href="/signin">Sign in</a></p>
        }
        else if (Model.Failed)
        {
            <h1>Confirmation failed</h1>
            <p>The confirmation link is invalid or has expired.</p>
            <p><a href="/resend-confirmation">Request a new confirmation email</a></p>
        }
        else
        {
            <h1>Confirm your email</h1>
            <p>Press the button to confirm your email address and activate your account.</p>
            <form method="post">
                <input asp-for="UserId" type="hidden" />
                <input asp-for="Token" type="hidden" />
                <button type="submit">Confirm my email</button>
            </form>
        }
    </main>
</body>
</html>
