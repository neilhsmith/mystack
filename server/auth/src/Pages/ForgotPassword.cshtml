@page "/forgot-password"
@model MyStack.Auth.Pages.ForgotPasswordModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Forgot password</title>
</head>
<body>
    <main>
        @if (Model.Sent)
        {
            <h1>Check your email</h1>
            <p>If that address has an account, we've sent a password reset link. It expires after
                two hours.</p>
        }
        else
        {
            <h1>Forgot your password?</h1>
            <p>Enter your email address and we'll send a link to choose a new one.</p>
            <form method="post">
                <div asp-validation-summary="All" role="alert"></div>
                <div>
                    <label asp-for="Email">Email</label>
                    <input asp-for="Email" type="email" autocomplete="username" required />
                </div>
                <button type="submit">Send reset link</button>
            </form>
            <p><a href="/signin">Back to sign in</a></p>
        }
    </main>
</body>
</html>
