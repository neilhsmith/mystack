@page "/change-password"
@model MyStack.Auth.Pages.ChangePasswordModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Change your password</title>
</head>
<body>
    <main>
        @if (Model.Changed)
        {
            <h1>Password changed</h1>
            <p>Your password has been changed and other sessions have been signed out.</p>
        }
        else
        {
            <h1>Change your password</h1>
            <form method="post">
                <div asp-validation-summary="All" role="alert"></div>
                <div>
                    <label asp-for="CurrentPassword">Current password</label>
                    <input asp-for="CurrentPassword" type="password" autocomplete="current-password" required />
                </div>
                <div>
                    <label asp-for="NewPassword">New password</label>
                    <input asp-for="NewPassword" type="password" autocomplete="new-password" required />
                </div>
                <div>
                    <label asp-for="ConfirmPassword">Confirm new password</label>
                    <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required />
                </div>
                <button type="submit">Change password</button>
            </form>
        }
    </main>
</body>
</html>
