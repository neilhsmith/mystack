@page "/change-password"
@model MyStack.Auth.Pages.ChangePasswordModel
@{
    ViewData["Title"] = Model.Changed ? "Password changed" : "Change your password";
}
@if (Model.Changed)
{
    <div class="grid gap-1 px-4 text-center">
        <h1 class="text-lg leading-snug font-semibold tracking-tight">Password changed</h1>
        <p class="text-muted-foreground text-sm">Your password has been changed and other sessions have been signed out.</p>
    </div>
}
else
{
    <div class="grid gap-1 px-4 text-center">
        <h1 class="text-lg leading-snug font-semibold tracking-tight">Change your password</h1>
        <p class="text-muted-foreground text-sm">Other sessions are signed out when it changes.</p>
    </div>
    <form method="post" class="grid gap-4 px-4">
        <partial name="_ErrorSummary" />
        <div class="grid gap-2">
            <label asp-for="CurrentPassword" class="text-sm leading-none font-medium select-none">Current password</label>
            <input asp-for="CurrentPassword" type="password" autocomplete="current-password" required
                   aria-invalid="@ViewData.ModelState.AriaInvalid("CurrentPassword")" aria-describedby="CurrentPassword-error"
                   class="border-input h-8 w-full min-w-0 rounded-lg border bg-transparent px-2.5 py-1 text-base md:text-sm transition-colors outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:bg-input/30 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40" />
            <p asp-validation-for="CurrentPassword" id="CurrentPassword-error" class="text-destructive text-sm empty:hidden"></p>
        </div>
        <div class="grid gap-2">
            <label asp-for="NewPassword" class="text-sm leading-none font-medium select-none">New password</label>
            <input asp-for="NewPassword" type="password" autocomplete="new-password" required
                   aria-invalid="@ViewData.ModelState.AriaInvalid("NewPassword")" aria-describedby="NewPassword-error"
                   class="border-input h-8 w-full min-w-0 rounded-lg border bg-transparent px-2.5 py-1 text-base md:text-sm transition-colors outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:bg-input/30 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40" />
            <p asp-validation-for="NewPassword" id="NewPassword-error" class="text-destructive text-sm empty:hidden"></p>
        </div>
        <div class="grid gap-2">
            <label asp-for="ConfirmPassword" class="text-sm leading-none font-medium select-none">Confirm new password</label>
            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required
                   aria-invalid="@ViewData.ModelState.AriaInvalid("ConfirmPassword")" aria-describedby="ConfirmPassword-error"
                   class="border-input h-8 w-full min-w-0 rounded-lg border bg-transparent px-2.5 py-1 text-base md:text-sm transition-colors outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:bg-input/30 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40" />
            <p asp-validation-for="ConfirmPassword" id="ConfirmPassword-error" class="text-destructive text-sm empty:hidden"></p>
        </div>
        <button type="submit"
                class="bg-primary text-primary-foreground hover:bg-primary/80 inline-flex h-8 w-full items-center justify-center gap-1.5 rounded-lg border border-transparent bg-clip-padding px-2.5 text-sm font-medium whitespace-nowrap transition-all outline-none select-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 active:translate-y-px">Change password</button>
    </form>
}
