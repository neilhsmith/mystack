@page "/signed-out"
@model MyStack.Auth.Pages.SignedOutModel
@{
    ViewData["Title"] = "Signed out";
}
<div class="grid gap-1 px-4 text-center">
    <h1 class="text-lg leading-snug font-semibold tracking-tight">Signed out</h1>
    <p class="text-muted-foreground text-sm">You've been signed out.</p>
</div>
<p class="text-muted-foreground px-4 text-center text-sm"><a href="/signin" class="text-foreground font-medium underline underline-offset-4">Sign in again</a></p>
