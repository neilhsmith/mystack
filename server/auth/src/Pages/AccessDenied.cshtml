@page "/access-denied"
@model MyStack.Auth.Pages.AccessDeniedModel
@{
    ViewData["Title"] = "Access denied";
}
<div class="grid gap-1 px-4 text-center">
    <h1 class="text-lg leading-snug font-semibold tracking-tight">Access denied</h1>
    <p class="text-muted-foreground text-sm">Your account doesn't have access to that.</p>
</div>
<p class="text-muted-foreground px-4 text-center text-sm"><a href="/" class="text-foreground font-medium underline underline-offset-4">Back to your account</a></p>
