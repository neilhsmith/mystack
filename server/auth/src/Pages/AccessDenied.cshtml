@page "/access-denied"
@model MyStack.Auth.Pages.AccessDeniedModel
@{
    ViewData["Title"] = "Access denied";
}
<div class="grid gap-1 px-4 text-center">
    <h1 class="text-lg leading-snug font-semibold tracking-tight">Access denied</h1>
    <p class="text-muted-foreground text-sm">Your account doesn't have access to that. If you think it should, the app that sent you here is the place to ask.</p>
</div>
