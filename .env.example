# Copy to .env (`cp .env.example .env`) — gitignored — or let `scripts/dev init <n>` write one
# per instance. Every value is optional: the defaults shown are what compose.yaml and scripts/dev
# already assume, so an untouched .env changes nothing. docker compose reads this file natively;
# scripts/dev derives the .NET-side configuration (connection strings, URLs, seeded client
# redirects) from the same values — docs/local-dev.md is the whole story.

# The instance name: namespaces containers/network/volumes, and auth's cookie names carry it so
# side-by-side instances keep disjoint browser sessions.
# COMPOSE_PROJECT_NAME=mystack

# ---- postgres ----
POSTGRES_USER=mystack
POSTGRES_PASSWORD=mystack
POSTGRES_DB=mystack
POSTGRES_PORT=5432

# ---- rabbitmq ----
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# ---- mailpit ----
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ---- telemetry dashboard (compose profile `otel`) ----
# Host ports for a local-only container, so they don't travel anywhere. What a hosted environment
# sets instead is the OTel SDK's own `OTEL_EXPORTER_OTLP_*` — same variable names everywhere, only
# the values differ.
OTEL_DASHBOARD_UI_PORT=18888
OTEL_DASHBOARD_OTLP_PORT=18889

# ---- apps (read by scripts/dev, not compose — the apps run on the host today) ----
AUTH_PORT=5100
WORKER_PORT=5200
WEB_PORT=3000
BRUNO_CALLBACK_PORT=8090
