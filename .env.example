# Copy to .env (`cp .env.example .env`) — gitignored. Every value below is optional: the defaults
# shown are the ones compose.yaml already substitutes, so an untouched .env changes nothing. Edit it
# when a host port is taken, or set COMPOSE_PROJECT_NAME to run a second isolated stack.

# COMPOSE_PROJECT_NAME=mystack

# ---- postgres ----
POSTGRES_USER=mystack
POSTGRES_PASSWORD=mystack
POSTGRES_DB=mystack
POSTGRES_PORT=5432

# ---- mailpit ----
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ---- telemetry dashboard (compose profile `otel`) ----
# Host ports for a local-only container, so they don't travel anywhere. What a hosted environment
# sets instead is the OTel SDK's own `OTEL_EXPORTER_OTLP_*` — same variable names everywhere, only
# the values differ. Those arrive with MyStack.Observability, the first thing that exports.
OTEL_DASHBOARD_UI_PORT=18888
OTEL_DASHBOARD_OTLP_PORT=18889
